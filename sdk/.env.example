# Environment for an application that CONSUMES MailPiston.
#
# Nothing here is read by MailPiston itself — the deployment's own configuration
# lives in the repository root `.env.example`, parsed once at boot by
# `server/core/config.ts`. This file is for the app on the other end: the one
# that sends mail through MailPiston and receives webhooks from it.
#
# It exists because migrating an app off a bundled email SDK is mostly a
# question of "which of my six environment variables still mean something", and
# the answer is easier to read as a table than to work out twice.
#
#   Inbound.new                 MailPiston
#   ─────────────────────────   ──────────────────────────────────────────────
#   INBOUND_API_KEY             MAILPISTON_API_KEY  (+ MAILPISTON_API_URL)
#   INBOUND_FROM_EMAIL          MAILPISTON_ADDRESS_ID — see the note below
#   INBOUND_SENDING_DOMAIN      (nothing: the domain is the address's domain)
#   INBOUND_REPLY_TO            (nothing: replies return to the sending address)
#   INBOUND_ADMIN_EMAIL         MAILPISTON_ADMIN_EMAIL — your app's own setting
#   INBOUND_WEBHOOK_TOKEN       MAILPISTON_ENDPOINT_SECRET

# The MailPiston deployment this app talks to.
MAILPISTON_API_URL=https://mailpiston.com

# Created in the dashboard under API Keys. Shown once, stored hashed — if you
# did not copy it, issue a new one rather than looking for it.
MAILPISTON_API_KEY=

# The address mail is sent AS, by id rather than by literal address.
#
# This is the one real shape change in the migration. A bundled SDK takes a
# `from` string and trusts it; MailPiston takes an address id, because sending
# as an address requires a concrete provider alias that authorises it, and a
# string cannot carry that fact. The practical effect is that a typo becomes a
# 404 at send time instead of mail that silently fails SPF a week later.
#
# Find it on the Addresses page. Send-capable addresses are the ones marked
# "Concrete alias · can send".
MAILPISTON_ADDRESS_ID=

# Where webhook deliveries for this app land, and the secret they are signed
# with. Both come from the endpoint you create under Endpoints — the secret is
# shown once, on creation.
#
# Verify with `verifyWebhook` from @mailpiston/sdk rather than comparing a
# token: deliveries are signed as HMAC-SHA256 over `timestamp + "." + body`, so
# a signature alone would stay valid forever and a captured delivery could be
# replayed at any point in the future. The default replay window is 300s.
MAILPISTON_ENDPOINT_SECRET=

# Your application's own address for operational mail. MailPiston has no opinion
# about this one; it is listed because the variable it replaces did.
MAILPISTON_ADMIN_EMAIL=admin@example.com
