# Parsed once by server/core/config.ts, which throws at boot on anything
# missing. Copy to .env.local for development.

# Origin this deployment answers on. Provider aliases are built from it, so a
# wrong value here means mail is delivered to a URL that does not exist.
# Production today: https://mailpiston.com
APP_URL=http://localhost:3000

# Public origin for canonical URLs and OG images. Production only; leave unset
# in development and metadataBase falls back to the Vercel subdomain.
NEXT_PUBLIC_SITE_URL=

# Neon. Both the pooled (transaction-capable) and HTTP (read) clients use this.
DATABASE_URL=postgresql://user:password@host.neon.tech/mailpiston?sslmode=require

# Auth — single operator, GitHub OAuth, one allow-listed address.
# BETTER_AUTH_SECRET: openssl rand -base64 32
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_OPERATOR_EMAILS=you@example.com

# Mail provider. `mock` runs the whole app with no Forward Email account.
MAIL_PROVIDER=mock
FORWARD_EMAIL_API_TOKEN=
FORWARD_EMAIL_API_URL=https://api.forwardemail.net
# Optional single-domain fallback. Per-domain keys saved in the dashboard are
# used when this is unset.
FORWARD_EMAIL_WEBHOOK_KEY=
FORWARD_EMAIL_TIMEOUT_MS=10000
# The plan's advertised monthly send allowance. The API reports only today's
# count and limit; leave unset and the dashboard shows the daily pair alone
# rather than a figure derived from it.
FORWARD_EMAIL_MONTHLY_ALLOWANCE=

# Personal-inbox forwarding. A MailPiston-owned domain whose catch-all points
# at this deployment. Replies from a verified personal inbox return through
# reply+<token>@ here, which keeps that address out of customer-facing headers.
RELAY_DOMAIN=
RELAY_TOKEN_TTL_DAYS=30

# Endpoint-secret encryption. 32 bytes, hex or base64:
#   openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# Object storage. All four R2 variables together select the R2 driver; absent,
# development falls back to the filesystem and production refuses to start.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Development-only object root, git-ignored.
LOCAL_STORAGE_DIR=.mailpiston-storage
# Raw MIME is the best debugging artifact and the largest thing we store.
STORE_RAW_MIME=false

# Private reply relay (Phase 6). A domain whose DNS you control — it never
# appears in customer-facing mail, so any owned domain works.
RELAY_DOMAIN=

# Webhook endpoints (Phase 7). The first delivery attempt runs inside the
# provider's inbound request, so this timeout is deliberately short — anything
# slower becomes a pending delivery and is retried out of band.
WEBHOOK_TIMEOUT_MS=8000
# The replay window receivers are told to enforce, in seconds.
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# Development only. Allows http:// and loopback endpoint URLs; refused outright
# when NODE_ENV=production, because disabling the SSRF guard there is the whole
# vulnerability.
WEBHOOK_ALLOW_INSECURE_TARGETS=false

# Retry engine (Phase 8). Inngest owns the timing of webhook retries; Neon
# stays the source of truth for their state. Both are optional locally — the
# Inngest dev server needs neither — and required in production, because a
# deployment whose retry engine silently does nothing shows only as a webhook
# that never arrives.
#   npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
